{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/maestro/closeout.schema.json",
  "title": "Maestro closeout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "result",
    "summary",
    "changed_files",
    "evidence_refs",
    "checks",
    "approvals",
    "residual_risks",
    "follow_ups",
    "owner_input_required",
    "closed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "cancelled",
        "frozen"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "blocked",
              "not_run"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_input_required": {
      "type": "boolean"
    },
    "archived_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "closed_at": {
      "type": "string"
    }
  }
}
