{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "task_id",
    "title",
    "route_tier",
    "goal",
    "scope_in",
    "scope_out",
    "constraints",
    "acceptance_signals",
    "risk_level",
    "stages",
    "evidence_expectations",
    "do_not_change"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "repository_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversation_mode": {
      "type": "string",
      "enum": [
        "discussion",
        "planning",
        "execution",
        "gated_execution"
      ]
    },
    "work_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "work_slug": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z][a-z0-9_-]*$|^[a-z][a-z0-9_-]*$"
    },
    "artifact_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "feature_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "route_tier": {
      "type": "string",
      "enum": [
        "direct",
        "task",
        "feature",
        "module_sized_work",
        "high_risk"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "do_not_change": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
