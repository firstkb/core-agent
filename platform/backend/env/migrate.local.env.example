MIGRATE_RUNTIME_ENVIRONMENT=dev

MIGRATE_DB_HOST=127.0.0.1
MIGRATE_DB_PORT=5432
MIGRATE_DB_USERNAME=postgres
MIGRATE_DB_PASSWORD=postgres
MIGRATE_DB_MASTERNAME=108-master
MIGRATE_DB_DEBUG=true
MIGRATE_DB_POOL_MAXIDLE=10
MIGRATE_DB_POOL_MAXOPEN=50
MIGRATE_DB_POOL_MAXLIFETIME=30m
MIGRATE_DB_POOL_MAXIDLETIME=5m

MIGRATE_MIGRATIONS_MASTERDIR=./migrations/postgres/master
MIGRATE_MIGRATIONS_TENANTDIR=./migrations/postgres/tenant
MIGRATE_MIGRATIONS_TENANTBUNDLEPATH=./bundle/tenant_schema_full.sql

# Optional bootstrap override for tenant DBs that already exist
# but are not yet registered in tenant_db.
# Main source of truth remains master registry tables.
MIGRATE_MIGRATIONS_TENANTDATABASES=108-sandbox,108-demo
MIGRATE_MIGRATIONS_DISABLEMASTER=false
MIGRATE_MIGRATIONS_DISABLETENANT=false
