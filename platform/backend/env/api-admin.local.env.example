ADMINAPI_RUNTIME_ENVIRONMENT=dev

ADMINAPI_HOSTAPP=:8081
ADMINAPI_ORIGIN=http://localhost:3001
ADMINAPI_TIMEOUT=30

ADMINAPI_TOKEN_SOURCE=trusted_headers
ADMINAPI_TOKEN_VALIDATE=none

ADMINAPI_DB_HOST=127.0.0.1
ADMINAPI_DB_PORT=5432
ADMINAPI_DB_USERNAME=postgres
ADMINAPI_DB_PASSWORD=postgres
ADMINAPI_DB_MASTERNAME=108-master
ADMINAPI_DB_AWSREGION=
ADMINAPI_DB_SSLMODE=disable
ADMINAPI_DB_DEBUG=true
ADMINAPI_DB_POOL_MAXIDLE=10
ADMINAPI_DB_POOL_MAXOPEN=50
ADMINAPI_DB_POOL_MAXLIFETIME=30m
ADMINAPI_DB_POOL_MAXIDLETIME=5m

# Optional local bearer mode:
# ADMINAPI_TOKEN_SOURCE=bearer
# ADMINAPI_TOKEN_VALIDATE=internal
# ADMINAPI_AUTH_AUDIENCE=platform-local
# ADMINAPI_AUTH_ISSUER=http://127.0.0.1:8082
# ADMINAPI_AUTH_JWTALG=rs256
# ADMINAPI_AUTH_KEYSOURCE=file
# ADMINAPI_AUTH_JWTPRIVATEPEMPATH=./certs/dev-auth-private.pem
# ADMINAPI_AUTH_JWTPUBLICPEMPATH=./certs/dev-auth-public.pem
# ADMINAPI_AUTH_JWTPRIVATEPEMSECRETNAME=
# ADMINAPI_AUTH_JWTPUBLICPEMSECRETNAME=
# ADMINAPI_AUTH_JWTAWSREGION=
# ADMINAPI_AUTH_JWTKMSKEYID=
