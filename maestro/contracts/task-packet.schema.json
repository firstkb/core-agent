{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/maestro/task-packet.schema.json",
  "title": "Maestro task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "work_id",
    "route_tier",
    "artifact_shape",
    "assigned_stage",
    "assigned_role",
    "goal",
    "path_scope",
    "constraints",
    "approvals",
    "evidence_expectations",
    "stop_conditions",
    "output_mode",
    "handoff_expectations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^packet-[a-z0-9][a-z0-9-]*-[0-9]{3}$"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "work_slug": {
      "type": [
        "string",
        "null"
      ]
    },
    "route_tier": {
      "type": "string",
      "enum": [
        "T1_task",
        "T2_staged",
        "T3_multi_step",
        "T4_gated"
      ]
    },
    "artifact_shape": {
      "type": "string",
      "enum": [
        "lightweight",
        "staged",
        "multi_step",
        "full"
      ]
    },
    "assigned_stage": {
      "description": "Packetable stage for a specialist or bounded Maestro assignment. `intake` is intentionally excluded because it is Maestro orchestration-only and does not produce a specialist packet.",
      "type": "string",
      "enum": [
        "research",
        "planning",
        "audit",
        "approval",
        "implementation",
        "verification",
        "review",
        "release",
        "closeout",
        "archive",
        "memory"
      ]
    },
    "assigned_role": {
      "description": "Assigned role for the packet. Release is schema-hard-linked to the release stage; other stage-role pairings remain adaptive but should follow the stage contract unless Maestro intentionally assigns bounded inline work.",
      "type": "string",
      "enum": [
        "maestro",
        "charlie",
        "grant",
        "mason",
        "scout",
        "lens",
        "release",
        "scribe",
        "archivist"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "background": {
      "type": "string"
    },
    "scope_in": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "scope_out": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "path_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "read_required",
        "read_optional",
        "forbidden",
        "high_risk"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "read_optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "high_risk": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "satisfied",
        "approval_refs"
      ],
      "properties": {
        "required": {
          "description": "Gate requirement names used in plans/packets. Map these to approval records as: owner_plan_approval -> approval_type plan; owner_execution_approval -> execution; owner_high_risk_approval -> high_risk_implementation; owner_release_approval -> release; owner_memory_migration_approval -> memory_migration; owner_archive_approval -> archive.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "owner_plan_approval",
              "owner_execution_approval",
              "owner_high_risk_approval",
              "owner_release_approval",
              "owner_memory_migration_approval",
              "owner_archive_approval"
            ]
          }
        },
        "satisfied": {
          "type": "boolean"
        },
        "approval_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_expectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "output_mode": {
      "description": "Default specialist return shape. Use handoff_json only when machine-readable continuity, auditability, release evidence, or resume/accountability requires it.",
      "type": "string",
      "enum": [
        "chat_summary",
        "agent_note",
        "evidence_md",
        "handoff_json"
      ]
    },
    "handoff_expectations": {
      "description": "Expected handoff details. May be empty when output_mode is chat_summary, agent_note, or evidence_md.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string",
      "default": "maestro"
    },
    "created_at": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "route_tier": {
            "const": "T4_gated"
          }
        },
        "required": [
          "route_tier"
        ]
      },
      "then": {
        "properties": {
          "artifact_shape": {
            "const": "full"
          },
          "approvals": {
            "properties": {
              "required": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_mode": {
            "const": "handoff_json"
          }
        },
        "required": [
          "output_mode"
        ]
      },
      "then": {
        "properties": {
          "handoff_expectations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assigned_stage": {
            "const": "release"
          }
        },
        "required": [
          "assigned_stage"
        ]
      },
      "then": {
        "properties": {
          "assigned_role": {
            "const": "release"
          },
          "output_mode": {
            "const": "handoff_json"
          },
          "handoff_expectations": {
            "minItems": 1
          },
          "approvals": {
            "properties": {
              "required": {
                "contains": {
                  "const": "owner_release_approval"
                }
              }
            }
          }
        }
      }
    }
  ]
}
