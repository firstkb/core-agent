{
  "name": "@platform/tenant-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@platform/api-client": "workspace:*",
    "@platform/app-shell": "workspace:*",
    "@platform/auth-core": "workspace:*",
    "@platform/collection-table": "workspace:*",
    "@platform/forms": "workspace:*",
    "@platform/i18n": "workspace:*",
    "@platform/platform-studio-core": "workspace:*",
    "@platform/tenant-core": "workspace:*",
    "@platform/ui-kit": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:dev": "env TENANT_WEB_APP_ENV=DEV sh -c 'tsc --noEmit && vite build --mode development'",
    "build:prod": "env TENANT_WEB_APP_ENV=PROD sh -c 'tsc --noEmit && vite build --mode production'",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
