{
  "agent_id": "module_orchestrator",
  "persona_name": "Maestro",
  "agent_version": "4.0.0",
  "contract_version": "4.0.0",
  "step": "orchestration",
  "role": "module lifecycle owner",
  "artifact_language": "en",
  "input_schema": "input.schema.json",
  "output_schema": "output.schema.json",
  "module_status_schema": "status.schema.json",
  "feature_status_schema": "feature-status.schema.json",
  "allowed_execution_modes": [
    "single"
  ],
  "artifacts": {
    "brief_md": {
      "path": "{artifacts_root}/{module}/brief.md",
      "media_type": "text/markdown",
      "role": "owner_facing_working_brief",
      "template": "../templates/brief.md.tmpl",
      "authored_by": "ai"
    },
    "status_json": {
      "path": "{artifacts_root}/{module}/status.json",
      "media_type": "application/json",
      "role": "machine_readable_module_state",
      "schema": "status.schema.json",
      "authored_by": "cli"
    },
    "feature_readme_md": {
      "path": "{artifacts_root}/{module}/features/{feature}/README.md",
      "media_type": "text/markdown",
      "role": "feature_charter",
      "template": "../templates/feature-readme.md.tmpl",
      "authored_by": "ai"
    },
    "feature_status_json": {
      "path": "{artifacts_root}/{module}/features/{feature}/status.json",
      "media_type": "application/json",
      "role": "machine_readable_feature_state",
      "schema": "feature-status.schema.json",
      "authored_by": "cli"
    }
  },
  "authorship_boundary": {
    "markdown_written_by_ai": true,
    "mutable_json_written_by_cli": true
  },
  "cli_surface": {
    "module": [
      "init",
      "submit-for-brief-approval",
      "return-to-discussion",
      "record-owner-approval",
      "freeze-brief",
      "prepare-execution"
    ],
    "feature": [
      "seed",
      "set-next-stage"
    ],
    "stage": [
      "start",
      "submit-handoff",
      "review"
    ]
  },
  "review_policy": {
    "stage_review_returns_to_module_orchestrator": true,
    "first_cut_decisions": [
      "accept",
      "revise"
    ]
  },
  "recommended_next_agents": [
    "brief_auditor",
    "research_codebase"
  ]
}
