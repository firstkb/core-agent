{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "module",
    "task"
  ],
  "properties": {
    "module": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_\\-/]*$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "discuss",
        "continue"
      ]
    },
    "owner_intent": {
      "type": "string",
      "enum": [
        "grant_review",
        "approve_brief",
        "seed_features",
        "approve_execution",
        "start_first_feature",
        "start_next_feature"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "properties": {
        "initiator": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
