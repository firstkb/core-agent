{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "discussion",
        "awaiting_owner_brief_approval",
        "brief_frozen",
        "awaiting_owner_execution_approval",
        "executing",
        "awaiting_owner_decision",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "boolean"
        },
        "frozen": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "approved",
        "frozen"
      ]
    },
    "owner_approvals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brief": {
          "type": "boolean"
        },
        "execution": {
          "type": "boolean"
        }
      },
      "required": [
        "brief",
        "execution"
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "current_action": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "phase",
    "brief",
    "owner_approvals",
    "features",
    "current_action",
    "updated_at"
  ]
}
