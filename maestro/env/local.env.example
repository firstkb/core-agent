# Maestro local settings.
#
# Copy values into maestro/env/local.env for local runs. Files matching
# maestro/env/*.env are intentionally ignored by git.

# API/backend defaults for manual local runs from maestro/backend.
MAESTRO_DATABASE_URL=postgres://postgres@localhost:5432/maestro_local?sslmode=disable
MAESTRO_ARTIFACT_ROOT=../artifacts/current
MAESTRO_HTTP_ADDR=127.0.0.1:8787
MAESTRO_MIGRATIONS_DIR=migrations
MAESTRO_RUN_MIGRATIONS=false
MAESTRO_API_URL=http://127.0.0.1:8787

# Dedicated disposable database for maestro/scripts/smoke-local.mjs.
# Keep this separate from real local Maestro state.
MAESTRO_SMOKE_DATABASE_URL=postgres://postgres@localhost:5432/maestro_smoke?sslmode=disable
MAESTRO_SMOKE_HTTP_ADDR=127.0.0.1:18787
MAESTRO_SMOKE_ARTIFACT_ROOT=artifacts/smoke

# Reset only known Maestro tables in the disposable smoke database.
MAESTRO_SMOKE_RESET_DATABASE=false

# Reset only the smoke artifact root.
MAESTRO_SMOKE_RESET_ARTIFACTS=true
