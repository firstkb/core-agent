{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chat_summary",
    "artifact_paths",
    "handoff"
  ],
  "properties": {
    "chat_summary": {
      "type": "string",
      "minLength": 1
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_readme",
        "handoff_json"
      ],
      "properties": {
        "attempt_readme": {
          "type": "string",
          "minLength": 1
        },
        "handoff_json": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "recommended_next_agent",
        "recommended_next_stage"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "complete",
            "blocked",
            "failed",
            "cancelled"
          ]
        },
        "recommended_next_agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommended_next_stage": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
