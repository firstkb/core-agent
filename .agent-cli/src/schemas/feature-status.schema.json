{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/module-orchestrator-v2/json-schemas/feature-status.schema.json",
  "title": "Feature Status",
  "description": "Durable feature lifecycle state for the aligned minimal V2 artifact model.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "seeded",
        "ready_for_stage",
        "stage_in_progress",
        "awaiting_review",
        "done",
        "blocked"
      ]
    },
    "readme_path": {
      "type": "string",
      "minLength": 1
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "next_stage": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "active_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^attempt-[0-9]{3}$"
    },
    "latest_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^attempt-[0-9]{3}$"
    },
    "latest_submitted_handoff_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_reviewed_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^attempt-[0-9]{3}$"
    },
    "last_reviewed_handoff_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "accept",
        "revise",
        null
      ]
    },
    "last_decision_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "feature_id",
    "phase",
    "readme_path",
    "current_stage",
    "next_stage",
    "active_attempt_id",
    "latest_attempt_id",
    "latest_submitted_handoff_ref",
    "last_reviewed_attempt_id",
    "last_reviewed_handoff_ref",
    "last_decision",
    "last_decision_reason",
    "blocked_reason",
    "updated_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "seeded"
          }
        }
      },
      "then": {
        "properties": {
          "current_stage": {
            "type": "null"
          },
          "active_attempt_id": {
            "type": "null"
          },
          "latest_submitted_handoff_ref": {
            "type": "null"
          },
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "ready_for_stage"
          }
        }
      },
      "then": {
        "properties": {
          "current_stage": {
            "type": "null"
          },
          "active_attempt_id": {
            "type": "null"
          },
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "stage_in_progress"
          }
        }
      },
      "then": {
        "properties": {
          "current_stage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "active_attempt_id": {
            "type": "string",
            "pattern": "^attempt-[0-9]{3}$"
          },
          "latest_attempt_id": {
            "type": "string",
            "pattern": "^attempt-[0-9]{3}$"
          },
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "awaiting_review"
          }
        }
      },
      "then": {
        "properties": {
          "current_stage": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "active_attempt_id": {
            "type": "null"
          },
          "latest_submitted_handoff_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "done"
          }
        }
      },
      "then": {
        "properties": {
          "current_stage": {
            "type": "null"
          },
          "active_attempt_id": {
            "type": "null"
          },
          "last_decision": {
            "const": "accept"
          },
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "current_stage": {
            "type": "null"
          },
          "active_attempt_id": {
            "type": "null"
          },
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "last_decision": {
            "enum": [
              "accept",
              "revise"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "last_reviewed_attempt_id": {
            "type": "string",
            "pattern": "^attempt-[0-9]{3}$"
          },
          "last_reviewed_handoff_ref": {
            "type": "string",
            "minLength": 1
          },
          "last_decision_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "examples": [
    {
      "schema_version": 1,
      "module_id": "avatar-service-test-execution-v2-pilot",
      "feature_id": "restore-executable-npm-test",
      "phase": "ready_for_stage",
      "readme_path": "artifacts/avatar-service-test-execution-v2-pilot/features/restore-executable-npm-test/README.md",
      "current_stage": null,
      "next_stage": "research",
      "active_attempt_id": null,
      "latest_attempt_id": "attempt-001",
      "latest_submitted_handoff_ref": "artifacts/avatar-service-test-execution-v2-pilot/features/restore-executable-npm-test/stages/research/attempt-001/handoff.json",
      "last_reviewed_attempt_id": "attempt-001",
      "last_reviewed_handoff_ref": "artifacts/avatar-service-test-execution-v2-pilot/features/restore-executable-npm-test/stages/research/attempt-001/handoff.json",
      "last_decision": "accept",
      "last_decision_reason": "Research is sufficient to proceed to implementation.",
      "blocked_reason": null,
      "updated_at": "2026-03-17T00:00:00Z"
    }
  ]
}
