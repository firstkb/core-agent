TENANTAPI_RUNTIME_ENVIRONMENT=dev

TENANTAPI_HOSTAPP=:8080
TENANTAPI_ORIGIN=http://localhost:3000
TENANTAPI_TIMEOUT=30

TENANTAPI_TOKEN_SOURCE=bearer
TENANTAPI_TOKEN_VALIDATE=internal

TENANTAPI_DB_HOST=127.0.0.1
TENANTAPI_DB_PORT=5432
TENANTAPI_DB_USERNAME=postgres
TENANTAPI_DB_PASSWORD=postgres
TENANTAPI_DB_MASTERNAME=108-master
TENANTAPI_DB_SSLMODE=disable
TENANTAPI_DB_DEBUG=true
TENANTAPI_DB_POOL_MAXIDLE=10
TENANTAPI_DB_POOL_MAXOPEN=50
TENANTAPI_DB_POOL_MAXLIFETIME=30m
TENANTAPI_DB_POOL_MAXIDLETIME=5m

TENANTAPI_TENANTS_CACHETTL=1m
TENANTAPI_TENANTS_KEY=dev-tenant-codec-key-2026

TENANTAPI_AUTH_AUDIENCE=platform-local
TENANTAPI_AUTH_ISSUER=http://127.0.0.1:8082
TENANTAPI_AUTH_JWTALG=rs256
TENANTAPI_AUTH_JWTPRIVATEPEMPATH=./certs/dev-auth-private.pem
TENANTAPI_AUTH_JWTPUBLICPEMPATH=./certs/dev-auth-public.pem
