{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chat_summary",
    "artifact_paths",
    "handoff"
  ],
  "properties": {
    "chat_summary": {
      "type": "string",
      "minLength": 1
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_md",
        "status_json"
      ],
      "properties": {
        "brief_md": {
          "type": "string",
          "minLength": 1
        },
        "status_json": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_input_required",
        "recommended_next_agent",
        "suggested_cli_commands"
      ],
      "properties": {
        "owner_input_required": {
          "type": "boolean"
        },
        "recommended_next_agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggested_cli_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
