{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "seeded",
        "ready_for_stage",
        "stage_in_progress",
        "awaiting_review",
        "done",
        "blocked"
      ]
    },
    "readme_path": {
      "type": "string",
      "minLength": 1
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "next_stage": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "active_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^attempt-[0-9]{3}$"
    },
    "latest_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^attempt-[0-9]{3}$"
    },
    "latest_submitted_handoff_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_reviewed_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^attempt-[0-9]{3}$"
    },
    "last_reviewed_handoff_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "accept",
        "revise",
        null
      ]
    },
    "last_decision_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "feature_id",
    "phase",
    "readme_path",
    "current_stage",
    "next_stage",
    "active_attempt_id",
    "latest_attempt_id",
    "latest_submitted_handoff_ref",
    "last_reviewed_attempt_id",
    "last_reviewed_handoff_ref",
    "last_decision",
    "last_decision_reason",
    "blocked_reason",
    "updated_at"
  ]
}
