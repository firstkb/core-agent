{
  "agent_id": "research_codebase",
  "persona_name": "Charlie",
  "agent_version": "2.0.0",
  "contract_version": "2.0.0",
  "step": "research",
  "role": "evidence-based codebase investigator",
  "artifact_language": "en",
  "input_schema": "input.schema.json",
  "output_schema": "output.schema.json",
  "handoff_schema": "handoff.schema.json",
  "allowed_execution_modes": [
    "sub_agent",
    "inline"
  ],
  "artifacts": {
    "attempt_readme": {
      "path": "{artifacts_root}/{module}/features/{feature}/stages/research/{attempt_id}/README.md",
      "media_type": "text/markdown",
      "role": "human_readable_research_attempt",
      "template": "../templates/README.md.tmpl",
      "authored_by": "ai"
    },
    "handoff_json": {
      "path": "{artifacts_root}/{module}/features/{feature}/stages/research/{attempt_id}/handoff.json",
      "media_type": "application/json",
      "role": "machine_readable_stage_handoff",
      "template": "../templates/handoff.template.json",
      "schema": "handoff.schema.json",
      "authored_by": "ai"
    }
  },
  "briefing_sources": {
    "sources_in_priority_order": [
      {
        "id": "feature_root_readme_md",
        "path": "{artifacts_root}/{module}/features/{feature}/README.md",
        "role": "stable_feature_charter",
        "required": false
      },
      {
        "id": "module_brief_md",
        "path": "{artifacts_root}/{module}/brief.md",
        "role": "module_brief",
        "required": false
      }
    ]
  },
  "authorship_boundary": {
    "markdown_written_by_ai": true,
    "handoff_json_written_by_ai": true,
    "mutable_json_written_by_cli": true
  },
  "recommended_next_agents": [
    "module_orchestrator"
  ],
  "legacy_for": "module_orchestrator artifacts/<module> runs",
  "prefer_for_new_work": "maestro_vnext"
}
