{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/maestro/stage-handoff.schema.json",
  "title": "Maestro stage handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "work_id",
    "packet_id",
    "stage",
    "role",
    "result",
    "recommendation",
    "summary",
    "evidence_refs",
    "changed_files",
    "checks",
    "risks",
    "owner_decision_required",
    "next_actions",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^handoff-[a-z]+-[a-z]+-[0-9]{3}$"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "research",
        "planning",
        "audit",
        "approval",
        "implementation",
        "verification",
        "review",
        "release",
        "closeout",
        "archive",
        "memory"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "maestro",
        "charlie",
        "grant",
        "mason",
        "scout",
        "lens",
        "release",
        "scribe",
        "archivist"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "recommendation": {
      "description": "Specialist recommendation only. This is not owner approval and does not satisfy an approval gate.",
      "type": "string",
      "enum": [
        "none",
        "continue",
        "revise",
        "block",
        "gate_ready",
        "request_owner_decision",
        "release",
        "archive",
        "close"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "observed_facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "blocked",
              "not_run"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals_consumed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "owner_decision_required": {
      "type": "boolean"
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "release"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "role": {
            "const": "release"
          },
          "approvals_consumed": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recommendation": {
            "enum": [
              "request_owner_decision",
              "block"
            ]
          }
        },
        "required": [
          "recommendation"
        ]
      },
      "then": {
        "properties": {
          "owner_decision_required": {
            "const": true
          }
        }
      }
    }
  ]
}
