{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/module-orchestrator-v2/json-schemas/stage-handoff.schema.json",
  "title": "Stage Handoff",
  "description": "Write-once downstream stage output for one attempt.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt-[0-9]{3}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "result": {
      "type": "string",
      "enum": [
        "ready_for_review",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "produced_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_stage": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "module_id",
    "feature_id",
    "stage",
    "attempt_id",
    "agent_id",
    "result",
    "summary",
    "evidence_refs",
    "produced_artifact_refs",
    "change_requests",
    "recommended_next_stage",
    "created_at"
  ],
  "examples": [
    {
      "schema_version": 1,
      "module_id": "avatar-service-test-execution",
      "feature_id": "restore-executable-npm-test",
      "stage": "research",
      "attempt_id": "attempt-001",
      "agent_id": "research_codebase",
      "result": "ready_for_review",
      "summary": "The root cause of the test failure is localized to an import mismatch.",
      "evidence_refs": [],
      "produced_artifact_refs": [],
      "change_requests": [],
      "recommended_next_stage": "implementation",
      "created_at": "2026-03-17T00:00:00Z"
    }
  ]
}